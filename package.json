{
  "name": "narx-commerce-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --all --include=\"src/**/*.js\" --include=\"public/**/*.js\" --reporter=lcov --reporter=text npm test"
  },
  "devDependencies": {
    "c8": "12.0.0"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
